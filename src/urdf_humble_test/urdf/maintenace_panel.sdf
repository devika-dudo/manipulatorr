<?xml version="1.0"?>
<sdf version="1.7">
  <model name="control_panel">
    <static>true</static>
    
    <!-- Main panel box -->
    <link name="panel_base">
      <pose>0 0 0 0 0 0</pose>
      <visual name="panel_visual">
        <geometry>
          <box>
            <size>0.33 0.45 0.02</size> <!-- 330mm x 450mm x 20mm -->
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="panel_collision">
        <geometry>
          <box>
            <size>0.33 0.45 0.02</size>
          </box>
        </geometry>
      </collision>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
        </inertia>
      </inertial>
    </link>

    <!-- ArUco marker - Top Left -->
    <link name="aruco_top_left">
      <pose>-0.12 0.18 0.015 0 0 0</pose>
      <visual name="aruco_top_left_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.0001 0.05 0.05</size> <!-- Very thin box like the example -->
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://control_panel/materials/scripts</uri>
            <uri>model://control_panel/materials/textures</uri>
            <name>Aruco0</name>
          </script>
        </material>
      </visual>
      <collision name="aruco_top_left_collision">
        <geometry>
          <box>
            <size>0.0001 0.05 0.05</size>
          </box>
        </geometry>
      </collision>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
    </link>

    <!-- ArUco marker - Top Right -->
    <link name="aruco_top_right">
      <pose>0.12 0.18 0.015 0 0 0</pose>
      <visual name="aruco_top_right_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.0001 0.05 0.05</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://control_panel/materials/scripts</uri>
            <uri>model://control_panel/materials/textures</uri>
            <name>Aruco1</name>
          </script>
        </material>
      </visual>
      <collision name="aruco_top_right_collision">
        <geometry>
          <box>
            <size>0.0001 0.05 0.05</size>
          </box>
        </geometry>
      </collision>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
    </link>

    <!-- ArUco marker - Bottom Left -->
    <link name="aruco_bottom_left">
      <pose>-0.12 -0.18 0.015 0 0 0</pose>
      <visual name="aruco_bottom_left_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.0001 0.05 0.05</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://urdf_humble_test/materials/scripts</uri>
            <uri>model://urdf_humble_test/materials/textures</uri>
            <name>Aruco2</name>
          </script>
        </material>
      </visual>
      <collision name="aruco_bottom_left_collision">
        <geometry>
          <box>
            <size>0.0001 0.05 0.05</size>
          </box>
        </geometry>
      </collision>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
    </link>

    <!-- Joint to attach top left ArUco to panel -->
    <joint name="aruco_top_left_joint" type="fixed">
      <parent>panel_base</parent>
      <child>aruco_top_left</child>
    </joint>

    <!-- Joint to attach top right ArUco to panel -->
    <joint name="aruco_top_right_joint" type="fixed">
      <parent>panel_base</parent>
      <child>aruco_top_right</child>
    </joint>

    <!-- Joint to attach bottom left ArUco to panel -->
    <joint name="aruco_bottom_left_joint" type="fixed">
      <parent>panel_base</parent>
      <child>aruco_bottom_left</child>
    </joint>

  </model>
</sdf>
