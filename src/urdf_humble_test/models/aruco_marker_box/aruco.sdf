<?xml version="1.0"?>
<sdf version="1.6">
  <model name="aruco_box">
    <pose>0 0 0.5 0 0 0</pose>
    <static>false</static>
    
    <link name="box_link">
      <pose>0 0 0 0 0 0</pose>
      
      <!-- Inertial properties -->
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.1667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.1667</iyy>
          <iyz>0</iyz>
          <izz>0.1667</izz>
        </inertia>
      </inertial>
      
      <!-- Collision -->
      <collision name="box_collision">
        <geometry>
          <box>
            <size>1.0 1.0 1.0</size>
          </box>
        </geometry>
      </collision>
      
      <!-- Main box visual (white/gray base) -->
      <visual name="box_visual">
        <geometry>
          <box>
            <size>1.0 1.0 1.0</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.9 1.0</ambient>
          <diffuse>0.9 0.9 0.9 1.0</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>
      
      <!-- ArUco marker on top face -->
      <visual name="aruco_top">
        <pose>0 0 0.501 0 0 0</pose>
        <geometry>
          <box>
            <size>0.8 0.8 0.001</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://aruco_box/materials/scripts</uri>
            <uri>model://aruco_box/materials/textures</uri>
            <name>Aruco0</name>
          </script>
        </material>
      </visual>
      
      <!-- ArUco marker on front face -->
      <visual name="aruco_front">
        <pose>0.501 0 0 0 1.5708 0</pose>
        <geometry>
          <box>
            <size>0.8 0.8 0.001</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://aruco_box/materials/scripts</uri>
            <uri>model://aruco_box/materials/textures</uri>
            <name>Aruco1</name>
          </script>
        </material>
      </visual>
      
    </link>
  </model>
</sdf>
