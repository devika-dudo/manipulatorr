<?xml version="1.0"?>
<sdf version="1.6">
  <model name="aruco_box">
    <pose>0 0 0.5 0 0 0</pose>
    <static>false</static>
    
    <link name="box_link">
      <pose>0 0 0 0 0 0</pose>
      
      <!-- Inertial properties -->
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.1667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.1667</iyy>
          <iyz>0</iyz>
          <izz>0.1667</izz>
        </inertia>
      </inertial>
      
      <!-- Collision -->
      <collision name="box_collision">
        <geometry>
          <box>
            <size>1.0 1.0 1.0</size>
          </box>
        </geometry>
      </collision>
      
      <!-- Main box visual - NO MATERIALS, just colors -->
      <visual name="box_visual">
        <geometry>
          <box>
            <size>1.0 1.0 1.0</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1.0</ambient>
          <diffuse>0.8 0.8 0.8 1.0</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>
      
      <!-- ArUco marker on top using direct texture -->
      <visual name="marker_top">
        <pose>0 0 0.501 0 0 0</pose>
        <geometry>
          <box>
            <size>0.6 0.6 0.001</size>
          </box>
        </geometry>
        <material>
  <script>
    <name>Gazebo/Bricks</name>
  </script>
</material>

      </visual>
      
      <!-- ArUco marker on front using direct texture -->
      <visual name="marker_front">
        <pose>0.501 0 0 0 1.5708 0</pose>
        <geometry>
          <box>
            <size>0.6 0.6 0.001</size>
          </box>
        </geometry>
        <material>
  <script>
    <uri>model://aruco_marker/materials/scripts/aruco.material</uri>
    <name>Aruco0</name>
  </script>
</material>
        
      </visual>
      
    </link>
  </model>
</sdf>
