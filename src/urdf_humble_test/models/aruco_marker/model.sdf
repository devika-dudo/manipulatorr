<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="sloped_control_panel">
    <static>true</static>
    
    <!-- Sloped control panel body -->
    <link name="panel_body">
      <!-- Pose: x y z roll pitch yaw -->
      <!-- Rotate forward (pitch) to mimic the sloped face -->
      <pose>0 0 0 0 0.5 0</pose>
      <visual name="panel_visual">
        <geometry>
          <box>
            <!-- Size: width, depth, height in meters -->
            <size>0.5 0.4 0.5</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
        </material>
      </visual>
      <collision name="panel_collision">
        <geometry>
          <box>
            <size>0.5 0.4 0.5</size>
          </box>
        </geometry>
      </collision>
    </link>
    
    <!-- ArUco Marker 1 - Top Left Corner -->
    <link name="aruco_marker_1">
      <!-- Position on the slanted front face, accounting for the panel's rotation -->
      <pose>-0.04 -0.16 0.31 1.57 0.5 0</pose>
      <visual name="aruco_visual_1">
        <geometry>
          <box>
            <size>0.05 0.001 0.05</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://aruco_marker/materials/scripts/aruco.material</uri>
            <name>Aruco0</name>
          </script>
        </material>
      </visual>
    </link>
    
    <!-- ArUco Marker 2 - Top Right Corner -->
    <link name="aruco_marker_2">
      <pose>0.3 -0.16 0.125 1.57 0.5 0</pose>
      <visual name="aruco_visual_2">
        <geometry>
          <box>
            <size>0.05 0.001 0.05</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://aruco_marker/materials/scripts/aruco.material</uri>
            <name>Aruco1</name>
          </script>
        </material>
      </visual>
    </link>
    
    <!-- ArUco Marker 3 - Bottom Center -->
    <link name="aruco_marker_3">
      <pose>-0.04 0.16 0.31 1.57 0.5 0</pose>
      <visual name="aruco_visual_3">
        <geometry>
          <box>
            <size>0.05 0.001 0.05</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>model://aruco_marker/materials/scripts/aruco.material</uri>
            <name>Aruco2</name>
          </script>
        </material>
      </visual>
    </link>
    
  </model>
</sdf>
