<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
      <include>
      <uri>model://ground_plane</uri>
    </include>
    
    <!-- Add sun for lighting -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Your plugin -->
<plugin name="gazebo_link_attacher" filename="libgazebo_link_attacher.so"/>

  </world>
</sdf>

