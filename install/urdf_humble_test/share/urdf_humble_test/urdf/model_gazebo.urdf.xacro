	<!-- Source: https://www.elephantrobotics.com/en/mycobot280-for-arduino-specifications-en/ -->
	<!-- Numbers are estimated when necessary -->
	<xacro:property name="effort" value="5.0"/>
	<xacro:property name="velocity" value="2.792527"/>
	
